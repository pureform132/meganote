{
    "name": "takenotes",
    "private": true,
    "version": "1.1.0",
    "description": "App de notas open source, local-first y en español con las funciones de Notion: bloques, bases de datos, búsqueda e importación.",
    "type": "module",
    "license": "MIT",
    "homepage": "https://pureform132.github.io/takenotes/",
    "repository": {
        "type": "git",
        "url": "https://github.com/pureform132/takenotes.git"
    },
    "keywords": [
        "notion-alternative",
        "notes",
        "note-taking",
        "local-first",
        "offline-first",
        "indexeddb",
        "react",
        "typescript",
        "block-editor",
        "kanban",
        "productivity",
        "spanish"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@fontsource/hanken-grotesk": "^5.2.5",
        "@fontsource/newsreader": "^5.2.5",
        "jszip": "^3.10.2",
        "papaparse": "^5.7.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@types/papaparse": "^5.5.2",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^5.0.0",
        "jsdom": "^31.0.1",
        "typescript": "~5.9.0",
        "vite": "^7.1.0",
        "vite-plugin-singlefile": "^2.3.4"
    }
